<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Only used to fetch poster pictures for "My Shows" from the URLs your streaming apps publish.
         Set "watchNext": false in config.json and the launcher never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the launcher read the "continue watching" list. Android only grants it if the TV allows it. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <provider android:authorities="android.media.tv" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_launcher"
        android:icon="@drawable/ic_launcher"
        android:label="Home"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|density|uiMode|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
